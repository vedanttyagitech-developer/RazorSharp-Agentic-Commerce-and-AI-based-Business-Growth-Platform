# --- secrets: never commit ---
*.csv
.env
.env.*
!.env.example
*secret*
*credential*
*_api_keys*
service-account*.json
*.pem
*.key

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# --- node ---
node_modules/
.next/
# Playwright writes these on every run, and a failed run fills them with screenshots.
test-results/
playwright-report/
.playwright/
dist/
build/
*.tsbuildinfo

# --- os / editor ---
.DS_Store
.idea/
.vscode/
# Per-machine CLI settings, written by the agent tooling. Local to one checkout, so
# committing it would hand every other machine this one's configuration.
.kiro/

# --- local infra ---
*.log
/tmp/
.terraform/
*.tfstate
*.tfstate.*

# Local verification notes; not published with source
/.local-verification/
.claude/
