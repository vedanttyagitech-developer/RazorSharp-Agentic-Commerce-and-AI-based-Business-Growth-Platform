# Names only. Never commit real values. The keys CSV in this folder is gitignored;
# move it out of the repository and load it through Secret Manager in deployment.

# --- Razorpay: TEST MODE ONLY ---
# Startup refuses any key not starting with rzp_test_ outside an explicit production profile.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_MODEL_ID=
# Transcribe Live serves from "global" only; a regional endpoint returns 404.
TRANSCRIBE_LOCATION=global

# --- Database ---
DATABASE_URL=

# Where the buyer copilot keeps its conversations, and a DIFFERENT database on purpose.
#
# google-adk owns and creates this schema -- sessions, events, app_states, user_states --
# and none of those tables carries a tenant_id or an RLS policy, while every tenant table in
# the commerce database carries both and alembic owns that schema. Pointing this at the
# commerce database would put five un-tenanted tables inside the boundary this platform
# spends real effort keeping, and hand a migration tool five tables it did not create.
# `scripts/bootstrap_local.sh` creates it; it takes no migrations, because the ADK makes its
# own tables on first use.
#
# Leaving this UNSET is supported and is what a test runs with: the copilot falls back to an
# in-memory store. The trap is that the fallback is invisible until something restarts, and
# then every buyer mid-conversation is talking to a stranger -- their cart survives, because
# the client re-sends its id and the checkout is in Postgres, but "add the milk we just
# talked about" does not.
ADK_SESSION_DATABASE_URL=

# --- Demo scenario controls ---
# Gates the scenario controller and the operator views (ADR 0003 D11), sent as the
# X-Scenario-Key header. Any sufficiently unguessable string; it authenticates nothing
# outside a demo profile.
#
# With this UNSET the guarded routes answer 404 -- deliberately, because the ADR says they
# "do not exist" outside a demo and a 401 would announce that they do. That is also the
# trap: the price-shift refusal demo simply stops working, and it looks like a missing
# feature rather than a missing variable. It belongs here, in the file, for exactly that
# reason -- it was once a hand-exported shell variable and a restart took it with no trace.
#
#   SCENARIO_KEY=$(uv run --no-sync python -c "import secrets; print(secrets.token_urlsafe(32))")
SCENARIO_KEY=

# --- UCP/AP2 protocol signing keys (test only, never production material) ---
# One private P-256 JWK as JSON each, on a single line, each carrying a DIFFERENT kid.
# Configured together or not at all; with neither set the well-known UCP profiles answer
# 404 and nothing is signed. There is deliberately no generated fallback -- a key minted
# at startup stops verifying its own past evidence the moment the process restarts.
#
# Generate a pair (do this ONCE and keep the values; regenerating invalidates every
# signature made under the old keys):
#
#   for role in merchant platform; do
#     uv run --no-sync python -c "
#   import json
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from jwcrypto.jwk import JWK
#   m = json.loads(JWK.from_pyca(ec.generate_private_key(ec.SECP256R1())).export())
#   m['kid'] = '$role-key-1'
#   print(json.dumps(m, sort_keys=True))"
#   done
#
# These two supersede AP2_MERCHANT_SIGNING_KEY_REF / AP2_PLATFORM_SIGNING_KEY_REF, which
# named a key-reference indirection that was never built and which nothing read.
UCP_MERCHANT_SIGNING_JWK=
UCP_PLATFORM_SIGNING_JWK=
