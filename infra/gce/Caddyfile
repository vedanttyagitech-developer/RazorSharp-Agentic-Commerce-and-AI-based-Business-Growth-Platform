# The one public surface. Everything else stays on loopback inside the machine.
#
# WHY A HOSTNAME AND NOT THE BARE IP
# ----------------------------------
# Razorpay Checkout is the point of the demo and it will not open over plain HTTP, so a
# deployment reachable only as `http://34.93.90.117` is a deployment where the one thing a
# judge is meant to press does nothing. `sslip.io` resolves any `a-b-c-d.sslip.io` to that
# address, which is enough for Let's Encrypt's HTTP-01 challenge to succeed -- so this gets
# a real certificate from a real authority with no DNS record for anyone to create.
#
# It is a stopgap on purpose. When the project's own domain points here, replace SITE_HOST
# and Caddy will obtain that certificate the same way.
{
	# A real address, so a certificate problem arrives as mail rather than as an outage.
	email {$ACME_EMAIL:admin@example.com}
}

# Three names for one site.
#
# `DOMAIN_HOST` is the real one and the only one that should outlive the demo. Caddy will
# obtain its certificate through an HTTP-01 challenge, which requires the DNS record to
# point *here* -- a Cloudflare-proxied record (orange cloud) answers that challenge itself
# and Caddy never sees it, so the certificate is never issued and Cloudflare then fails the
# origin handshake with a 525. Grey cloud, and this works on the next retry.
#
# Two names for one site, and the second is not redundant. `sslip.io` is on the filter
# lists several ad blockers ship by default -- the page renders and every `fetch` from it
# is refused ERR_BLOCKED_BY_CLIENT, which looks exactly like a broken backend and is not
# one. `nip.io` is the same trick from a different domain and is not usually on those
# lists. A judge whose browser blocks one can be handed the other.
{$SITE_HOST}, {$ALT_HOST}, {$DOMAIN_HOST} {
	encode zstd gzip

	# The voice socket, and only that one path of the gateway. A WebSocket cannot carry a
	# cookie the way a fetch does, so it is published here and authorised by a ticket the
	# app minted server-side: random bytes, sixty seconds, consumed on first connection.
	# The gateway checks the Origin as a second lock.
	@voice path /v1/voice/stream
	reverse_proxy @voice voice:8100

	# The API serves the complete static frontend and its browser session boundary.
	# Stream frames immediately; the voice WebSocket keeps its separate gateway above.
	reverse_proxy api:8000 {
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}

# Anything that arrives by a name this file does not know -- and the bare IP is the one
# that matters -- sent to the name that has a certificate.
#
# THE DEFECT THIS EXISTS TO REMOVE
# --------------------------------
# The block above claims three hostnames. A request for anything else still reached Caddy,
# and automatic HTTPS answered it the only way it could: `http://34.93.90.117` redirected
# to `https://34.93.90.117`, where there is no certificate for a bare IP and the handshake
# simply failed. Typing the address of the machine the demo runs on produced a browser that
# could not open the site at all -- not a warning page, nothing. That is the address a
# person reads off a console and the one this project's own notes still quote.
#
# The scheme is written out, which is what keeps this from recursing: an explicit `http://`
# site address turns automatic HTTPS off for this block, so it stays a plain HTTP listener
# and redirects once, to a name that works.
#
# The ACME challenge is excluded rather than trusted to ordering. Caddy does install its
# own HTTP-01 handler ahead of site routes, so this is belt and braces -- but a certificate
# that silently stops renewing is a 525 three months from now, and the guard costs nothing.
http:// {
	@acme path /.well-known/acme-challenge/*
	respond @acme 404

	redir https://{$DOMAIN_HOST}{uri} permanent
}
